# Server
NODE_ENV=development
PORT=5000
TRUST_PROXY=false
ENABLE_API_DOCS=true
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=100kb

# Database
MONGO_URI=mongodb://localhost:27017/church

# Redis
# Prefer REDIS_URL in production (for example, hosted Redis over TLS / Upstash).
REDIS_URL=
# Local development fallback:
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_REQUIRED=false
REDIS_READY_TIMEOUT_MS=2500

# JWT
# Use long, random secrets. Production startup now rejects weak or placeholder values.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_MS=604800000

# Cloudflare R2 storage
# Set R2_REQUIRED=true in production if uploads must be enabled.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_REGION=auto
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REQUIRED=false

# CORS
# Comma-separate trusted frontend origins. Do not use * with credentials in production.
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Rate limiting
# Production SPAs often need a higher limit because authenticated requests may trigger CORS preflights.
# Production requires Redis-backed rate limiting; do not set REDIS_REQUIRED=false in production.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
RATE_LIMIT_ANONYMOUS_MAX=600
RATE_LIMIT_AUTHENTICATED_MAX=5000

# Uploads
MAX_FILE_SIZE=5242880

# Web Push (required only when browser push notifications should be enabled)
# Generate these with: npm run push:generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Use a real mailbox so browser vendors can reach you for abuse/contact issues.
VAPID_EMAIL=notifications@example.com

# Cache TTL (seconds)
CACHE_USER_TTL=3600
CACHE_PERMISSIONS_TTL=1800

# MongoDB backups
# Backups stay disabled until you finish Google Drive setup and set BACKUP_ENABLED=true.
BACKUP_ENABLED=false
BACKUP_SCHEDULER_ENABLED=true
BACKUP_INTERVAL_DAYS=3
# Cron controls how often the server checks whether a backup is due.
BACKUP_CRON=0 2 * * *
BACKUP_TIMEZONE=UTC
BACKUP_TEMP_DIR=tmp/backups
BACKUP_FILE_PREFIX=church-mongodb-backup
BACKUP_LOCAL_RETENTION_DAYS=1
BACKUP_LOCK_TIMEOUT_MINUTES=240
BACKUP_MONGODUMP_PATH=mongodump
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_FILE=secure/google-oauth-client.json
GOOGLE_OAUTH_TOKEN_FILE=secure/google-oauth-token.json

# Backup email notifications
BACKUP_EMAIL_NOTIFICATIONS_ENABLED=false
BACKUP_NOTIFICATION_EMAILS=gergessamuel100@gmail.com
BACKUP_NOTIFICATION_SUBJECT_PREFIX=[Church Backup]
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# AI features
# ─────────────────────────────────────────────────────────────────────────────
# Master kill switch. Defaults to false: a deployment that has not explicitly
# opted in ships with AI off, and a blanked environment fails closed.
AI_ENABLED=false

# Per-feature switches. Each is independently revocable without a deploy.
AI_FEATURE_NOTIFICATION_DRAFT=true
AI_FEATURE_ANALYTICS_NARRATIVE=true
AI_FEATURE_IMPORT_AMBIGUITY=true

# Providers. Anthropic is primary; OpenAI is the fallback.
AI_PROVIDER_ANTHROPIC_ENABLED=true
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_VERSION=2023-06-01

AI_PROVIDER_OPENAI_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# Gemini is DISABLED and requires two keys to turn on. On Google's unpaid tier
# the terms permit using prompts for training and allow human review, and the
# automatic paid-terms carve-out does not cover this deployment's region.
# Attaching an active Cloud Billing account is the opt-out; setting
# AI_GEMINI_BILLING_VERIFIED=true asserts that this has actually been done.
# The server refuses to boot if the provider is enabled without it.
AI_PROVIDER_GEMINI_ENABLED=false
AI_GEMINI_BILLING_VERIFIED=false
GEMINI_API_KEY=

# DeepSeek is a REJECTED provider (PRC storage, trains on input by default,
# open-ended retention, no DPA). There is no adapter for it, and production
# refuses to boot if DEEPSEEK_API_KEY is set. Do not add one.

# Model identifiers. Swapping a model within a provider is a secret change plus
# a restart. Swapping providers requires a deploy — that is a privacy decision
# and is deliberately not reachable through an environment variable.
AI_MODEL_ANTHROPIC_SONNET=claude-sonnet-5
AI_MODEL_ANTHROPIC_HAIKU=claude-haiku-4-5
AI_MODEL_OPENAI_MAIN=gpt-5.6-terra
AI_MODEL_GEMINI_MAIN=gemini-3.5-flash

# Request handling.
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_RESET_MS=60000

# Hard spend ceilings in USD. Reaching the monthly cap stops all AI usage.
AI_DAILY_SPEND_USD=5
AI_MONTHLY_SPEND_USD=100
