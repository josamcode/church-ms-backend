# Server
NODE_ENV=development
PORT=5000
TRUST_PROXY=false
ENABLE_API_DOCS=true

# Database
MONGO_URI=mongodb://localhost:27017/church

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_REQUIRED=false
REDIS_READY_TIMEOUT_MS=2500

# JWT
# Use long, random secrets. Production startup now rejects weak or placeholder values.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_MS=604800000

# Cloudinary
# Set CLOUDINARY_REQUIRED=true in production if uploads must be enabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_REQUIRED=false

# CORS
# Comma-separate trusted frontend origins. Do not use * with credentials in production.
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Uploads
MAX_FILE_SIZE=5242880

# Cache TTL (seconds)
CACHE_USER_TTL=3600
CACHE_PERMISSIONS_TTL=1800
